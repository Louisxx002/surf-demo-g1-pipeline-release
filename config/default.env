# Default runtime configuration. Put machine-specific overrides and API keys in
# config/local.env; it is sourced before defaults are resolved so legacy QWEN_*
# overrides still work.

WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPS_ROOT="${DEPS_ROOT:-${WORKSPACE_ROOT}/deps}"

LOCAL_ENV="${WORKSPACE_ROOT}/config/local.env"
if [[ -f "${LOCAL_ENV}" ]]; then
  source "${LOCAL_ENV}"
fi

# Paths to bundled dependencies. LLM_ROOT intentionally defaults to the legacy
# vendored directory because it contains the Unitree Python SDK subtree.
SURF_ROOT="${SURF_ROOT:-${DEPS_ROOT}/SURF2026_VoiceModule-main}"
LLM_ROOT="${LLM_ROOT:-${QWEN_ROOT:-${DEPS_ROOT}/qwen_ros_node_edg_tts}}"
QWEN_ROOT="${QWEN_ROOT:-${LLM_ROOT}}"

# LLM mode: listen means every /audio_msg is handled. wake means the LLM node
# also applies its own wake-word filter after SURF ASR.
SURF_LLM_MODE="${SURF_LLM_MODE:-${SURF_QWEN_MODE:-wake}}"
SURF_QWEN_MODE="${SURF_QWEN_MODE:-${SURF_LLM_MODE}}"
SURF_LLM_WAKE_WORDS="${SURF_LLM_WAKE_WORDS:-${SURF_QWEN_WAKE_WORDS:-}}"
SURF_QWEN_WAKE_WORDS="${SURF_QWEN_WAKE_WORDS:-${SURF_LLM_WAKE_WORDS}}"

# Voice input source for integrated pipeline.
VOICE_AUDIO_SOURCE="${VOICE_AUDIO_SOURCE:-robot}"

# Low-latency SURF overrides. run_surf_voice_runtime.sh reapplies these after
# sourcing SURF's original default.env.
SURF_LLM_ASR_WINDOW_SEC="${SURF_LLM_ASR_WINDOW_SEC:-${SURF_QWEN_ASR_WINDOW_SEC:-8.0}}"
SURF_QWEN_ASR_WINDOW_SEC="${SURF_QWEN_ASR_WINDOW_SEC:-${SURF_LLM_ASR_WINDOW_SEC}}"
SURF_LLM_VAD_HOLDOFF_SEC="${SURF_LLM_VAD_HOLDOFF_SEC:-${SURF_QWEN_VAD_HOLDOFF_SEC:-4.0}}"
SURF_QWEN_VAD_HOLDOFF_SEC="${SURF_QWEN_VAD_HOLDOFF_SEC:-${SURF_LLM_VAD_HOLDOFF_SEC}}"

# Wake word mode for SURF voice runtime.
VOICE_WAKE_WORD_LANG="${VOICE_WAKE_WORD_LANG:-zh}"

# Keep FunASR's internal VAD disabled by default. The outer WebRTC VAD handles
# endpointing; set VOICE_ASR_VAD_MODEL=fsmn-vad only when explicitly testing it.
VOICE_ASR_VAD_MODEL="${VOICE_ASR_VAD_MODEL-}"

# Must stay 0 in this integrated setup, because SURF is the ASR publisher.
LLM_AUTOSTART_ASR_BRIDGE="${LLM_AUTOSTART_ASR_BRIDGE:-${QWEN_AUTOSTART_ASR_BRIDGE:-0}}"
QWEN_AUTOSTART_ASR_BRIDGE="${QWEN_AUTOSTART_ASR_BRIDGE:-${LLM_AUTOSTART_ASR_BRIDGE}}"

# LLM runtime configuration.
LLM_AUDIO_TOPIC="${LLM_AUDIO_TOPIC:-${QWEN_AUDIO_TOPIC:-/audio_msg}}"
QWEN_AUDIO_TOPIC="${QWEN_AUDIO_TOPIC:-${LLM_AUDIO_TOPIC}}"
LLM_PYTHON="${LLM_PYTHON:-${QWEN_PYTHON:-${HOME}/miniconda3/envs/llm/bin/python}}"
QWEN_PYTHON="${QWEN_PYTHON:-${LLM_PYTHON}}"
LLM_SERVER_URL="${LLM_SERVER_URL:-${QWEN_SERVER_URL:-http://127.0.0.1:8000/infer}}"
QWEN_SERVER_URL="${QWEN_SERVER_URL:-${LLM_SERVER_URL}}"
LLM_REQUEST_TIMEOUT_SEC="${LLM_REQUEST_TIMEOUT_SEC:-${QWEN_REQUEST_TIMEOUT_SEC:-60}}"
QWEN_REQUEST_TIMEOUT_SEC="${QWEN_REQUEST_TIMEOUT_SEC:-${LLM_REQUEST_TIMEOUT_SEC}}"
LLM_WAKE_WORDS="${LLM_WAKE_WORDS:-${QWEN_WAKE_WORDS:-你好小浦,小浦}}"
QWEN_WAKE_WORDS="${QWEN_WAKE_WORDS:-${LLM_WAKE_WORDS}}"
LLM_MODEL_PATH="${LLM_MODEL_PATH:-${QWEN_MODEL_PATH:-${DEPS_ROOT}/Qwen3.5-0.8B/model}}"
QWEN_MODEL_PATH="${QWEN_MODEL_PATH:-${LLM_MODEL_PATH}}"
LLM_REPLY_BACKEND="${LLM_REPLY_BACKEND:-${QWEN_REPLY_BACKEND:-rag}}"
QWEN_REPLY_BACKEND="${QWEN_REPLY_BACKEND:-${LLM_REPLY_BACKEND}}"
LLM_DASHSCOPE_MODEL="${LLM_DASHSCOPE_MODEL:-${QWEN_DASHSCOPE_MODEL:-qwen-plus}}"
QWEN_DASHSCOPE_MODEL="${QWEN_DASHSCOPE_MODEL:-${LLM_DASHSCOPE_MODEL}}"
LLM_DASHSCOPE_BASE_URL="${LLM_DASHSCOPE_BASE_URL:-${QWEN_DASHSCOPE_BASE_URL:-https://dashscope.aliyuncs.com/compatible-mode/v1}}"
QWEN_DASHSCOPE_BASE_URL="${QWEN_DASHSCOPE_BASE_URL:-${LLM_DASHSCOPE_BASE_URL}}"
LLM_DEEPSEEK_MODEL="${LLM_DEEPSEEK_MODEL:-${QWEN_DEEPSEEK_MODEL:-${CHAT_MODEL:-deepseek-v4-pro}}}"
QWEN_DEEPSEEK_MODEL="${QWEN_DEEPSEEK_MODEL:-${LLM_DEEPSEEK_MODEL}}"
LLM_DEEPSEEK_BASE_URL="${LLM_DEEPSEEK_BASE_URL:-${QWEN_DEEPSEEK_BASE_URL:-${OPENAI_BASE_URL:-https://api.deepseek.com}}}"
QWEN_DEEPSEEK_BASE_URL="${QWEN_DEEPSEEK_BASE_URL:-${LLM_DEEPSEEK_BASE_URL}}"
LLM_RAG_SERVER_URL="${LLM_RAG_SERVER_URL:-${QWEN_RAG_SERVER_URL:-http://127.0.0.1:8010/chat}}"
QWEN_RAG_SERVER_URL="${QWEN_RAG_SERVER_URL:-${LLM_RAG_SERVER_URL}}"
LLM_SERVER_HOST="${LLM_SERVER_HOST:-${QWEN_SERVER_HOST:-0.0.0.0}}"
QWEN_SERVER_HOST="${QWEN_SERVER_HOST:-${LLM_SERVER_HOST}}"
LLM_SERVER_PORT="${LLM_SERVER_PORT:-${QWEN_SERVER_PORT:-8000}}"
QWEN_SERVER_PORT="${QWEN_SERVER_PORT:-${LLM_SERVER_PORT}}"
LLM_MAX_NEW_TOKENS="${LLM_MAX_NEW_TOKENS:-${QWEN_MAX_NEW_TOKENS:-50}}"
QWEN_MAX_NEW_TOKENS="${QWEN_MAX_NEW_TOKENS:-${LLM_MAX_NEW_TOKENS}}"
LLM_TEMPERATURE="${LLM_TEMPERATURE:-${QWEN_TEMPERATURE:-0.3}}"
QWEN_TEMPERATURE="${QWEN_TEMPERATURE:-${LLM_TEMPERATURE}}"
LLM_RUNTIME_DIR="${LLM_RUNTIME_DIR:-${QWEN_RUNTIME_DIR:-${WORKSPACE_ROOT}/runtime}}"
QWEN_RUNTIME_DIR="${QWEN_RUNTIME_DIR:-${LLM_RUNTIME_DIR}}"

UNITREE_DOMAIN_ID="${UNITREE_DOMAIN_ID:-0}"
UNITREE_ENABLE="${UNITREE_ENABLE:-1}"
UNITREE_NETWORK_INTERFACE="${UNITREE_NETWORK_INTERFACE:-enp8s0}"
UNITREE_AUDIO_VOLUME="${UNITREE_AUDIO_VOLUME:-85}"

LLM_ACTION_ENABLE="${LLM_ACTION_ENABLE:-${QWEN_ACTION_ENABLE:-1}}"
QWEN_ACTION_ENABLE="${QWEN_ACTION_ENABLE:-${LLM_ACTION_ENABLE}}"
LLM_ACTION_EXECUTE="${LLM_ACTION_EXECUTE:-${QWEN_ACTION_EXECUTE:-1}}"
QWEN_ACTION_EXECUTE="${QWEN_ACTION_EXECUTE:-${LLM_ACTION_EXECUTE}}"
LLM_ACTION_BACKEND="${LLM_ACTION_BACKEND:-${QWEN_ACTION_BACKEND:-deepseek}}"
QWEN_ACTION_BACKEND="${QWEN_ACTION_BACKEND:-${LLM_ACTION_BACKEND}}"
LLM_ACTION_THRESHOLD="${LLM_ACTION_THRESHOLD:-${QWEN_ACTION_THRESHOLD:-0.8}}"
QWEN_ACTION_THRESHOLD="${QWEN_ACTION_THRESHOLD:-${LLM_ACTION_THRESHOLD}}"
LLM_ACTION_AUTO_RELEASE="${LLM_ACTION_AUTO_RELEASE:-${QWEN_ACTION_AUTO_RELEASE:-0}}"
QWEN_ACTION_AUTO_RELEASE="${QWEN_ACTION_AUTO_RELEASE:-${LLM_ACTION_AUTO_RELEASE}}"
LLM_ACTION_RELEASE_AFTER_SEC="${LLM_ACTION_RELEASE_AFTER_SEC:-${QWEN_ACTION_RELEASE_AFTER_SEC:-5}}"
QWEN_ACTION_RELEASE_AFTER_SEC="${QWEN_ACTION_RELEASE_AFTER_SEC:-${LLM_ACTION_RELEASE_AFTER_SEC}}"
LLM_ACTION_ROOT="${LLM_ACTION_ROOT:-${QWEN_ACTION_ROOT:-${DEPS_ROOT}/unitree_g1_action_classifier_package}}"
QWEN_ACTION_ROOT="${QWEN_ACTION_ROOT:-${LLM_ACTION_ROOT}}"
LLM_ACTION_PYTHON="${LLM_ACTION_PYTHON:-${QWEN_ACTION_PYTHON:-${LLM_ACTION_ROOT}/.venv/bin/python}}"
QWEN_ACTION_PYTHON="${QWEN_ACTION_PYTHON:-${LLM_ACTION_PYTHON}}"
LLM_ACTION_SCRIPT="${LLM_ACTION_SCRIPT:-${QWEN_ACTION_SCRIPT:-${LLM_ACTION_ROOT}/arm_action_classifier/arm_action_classifier.py}}"
QWEN_ACTION_SCRIPT="${QWEN_ACTION_SCRIPT:-${LLM_ACTION_SCRIPT}}"
LLM_ACTION_RUNNER="${LLM_ACTION_RUNNER:-${QWEN_ACTION_RUNNER:-${LLM_ACTION_ROOT}/unitree_sdk2/build/bin/g1_arm_action_example}}"
QWEN_ACTION_RUNNER="${QWEN_ACTION_RUNNER:-${LLM_ACTION_RUNNER}}"
LLM_ACTION_KEYWORD_FIRST="${LLM_ACTION_KEYWORD_FIRST:-${QWEN_ACTION_KEYWORD_FIRST:-1}}"
QWEN_ACTION_KEYWORD_FIRST="${QWEN_ACTION_KEYWORD_FIRST:-${LLM_ACTION_KEYWORD_FIRST}}"

# SURF context topics consumed by the integrated LLM node.
SURF_WAKE_TOPIC="${SURF_WAKE_TOPIC:-/wake_word_event}"
SURF_VAD_TOPIC="${SURF_VAD_TOPIC:-/vad_state}"
SURF_SPEAKER_TOPIC="${SURF_SPEAKER_TOPIC:-/speaker_id}"
SURF_LLM_INCLUDE_SPEAKER_CONTEXT="${SURF_LLM_INCLUDE_SPEAKER_CONTEXT:-${SURF_QWEN_INCLUDE_SPEAKER_CONTEXT:-1}}"
SURF_QWEN_INCLUDE_SPEAKER_CONTEXT="${SURF_QWEN_INCLUDE_SPEAKER_CONTEXT:-${SURF_LLM_INCLUDE_SPEAKER_CONTEXT}}"
SURF_LLM_WRITE_CONTEXT_STATUS="${SURF_LLM_WRITE_CONTEXT_STATUS:-${SURF_QWEN_WRITE_CONTEXT_STATUS:-1}}"
SURF_QWEN_WRITE_CONTEXT_STATUS="${SURF_QWEN_WRITE_CONTEXT_STATUS:-${SURF_LLM_WRITE_CONTEXT_STATUS}}"
SURF_LLM_FILTER_BAD_ASR="${SURF_LLM_FILTER_BAD_ASR:-${SURF_QWEN_FILTER_BAD_ASR:-1}}"
SURF_QWEN_FILTER_BAD_ASR="${SURF_QWEN_FILTER_BAD_ASR:-${SURF_LLM_FILTER_BAD_ASR}}"
SURF_LLM_MIN_ASR_CHARS="${SURF_LLM_MIN_ASR_CHARS:-${SURF_QWEN_MIN_ASR_CHARS:-2}}"
SURF_QWEN_MIN_ASR_CHARS="${SURF_QWEN_MIN_ASR_CHARS:-${SURF_LLM_MIN_ASR_CHARS}}"
SURF_LLM_MIN_AUDIO_CONFIDENCE="${SURF_LLM_MIN_AUDIO_CONFIDENCE:-${SURF_QWEN_MIN_AUDIO_CONFIDENCE:-0.55}}"
SURF_QWEN_MIN_AUDIO_CONFIDENCE="${SURF_QWEN_MIN_AUDIO_CONFIDENCE:-${SURF_LLM_MIN_AUDIO_CONFIDENCE}}"
SURF_LLM_WAKE_ACK_ENABLE="${SURF_LLM_WAKE_ACK_ENABLE:-${SURF_QWEN_WAKE_ACK_ENABLE:-1}}"
SURF_QWEN_WAKE_ACK_ENABLE="${SURF_QWEN_WAKE_ACK_ENABLE:-${SURF_LLM_WAKE_ACK_ENABLE}}"
SURF_LLM_WAKE_ACK_TEXT="${SURF_LLM_WAKE_ACK_TEXT:-${SURF_QWEN_WAKE_ACK_TEXT:-我在}}"
SURF_QWEN_WAKE_ACK_TEXT="${SURF_QWEN_WAKE_ACK_TEXT:-${SURF_LLM_WAKE_ACK_TEXT}}"
SURF_LLM_WAKE_ACK_TEXT_ZH="${SURF_LLM_WAKE_ACK_TEXT_ZH:-${SURF_QWEN_WAKE_ACK_TEXT_ZH:-我在}}"
SURF_QWEN_WAKE_ACK_TEXT_ZH="${SURF_QWEN_WAKE_ACK_TEXT_ZH:-${SURF_LLM_WAKE_ACK_TEXT_ZH}}"
SURF_LLM_WAKE_ACK_TEXT_EN="${SURF_LLM_WAKE_ACK_TEXT_EN:-${SURF_QWEN_WAKE_ACK_TEXT_EN:-here i am}}"
SURF_QWEN_WAKE_ACK_TEXT_EN="${SURF_QWEN_WAKE_ACK_TEXT_EN:-${SURF_LLM_WAKE_ACK_TEXT_EN}}"
SURF_LLM_WAKE_ACK_COOLDOWN_SEC="${SURF_LLM_WAKE_ACK_COOLDOWN_SEC:-${SURF_QWEN_WAKE_ACK_COOLDOWN_SEC:-1.0}}"
SURF_QWEN_WAKE_ACK_COOLDOWN_SEC="${SURF_QWEN_WAKE_ACK_COOLDOWN_SEC:-${SURF_LLM_WAKE_ACK_COOLDOWN_SEC}}"
SURF_LLM_WAKE_ACK_ACTION_ENABLE="${SURF_LLM_WAKE_ACK_ACTION_ENABLE:-${SURF_QWEN_WAKE_ACK_ACTION_ENABLE:-1}}"
SURF_QWEN_WAKE_ACK_ACTION_ENABLE="${SURF_QWEN_WAKE_ACK_ACTION_ENABLE:-${SURF_LLM_WAKE_ACK_ACTION_ENABLE}}"
SURF_LLM_WAKE_ACK_ACTION_ID="${SURF_LLM_WAKE_ACK_ACTION_ID:-${SURF_QWEN_WAKE_ACK_ACTION_ID:-25}}"
SURF_QWEN_WAKE_ACK_ACTION_ID="${SURF_QWEN_WAKE_ACK_ACTION_ID:-${SURF_LLM_WAKE_ACK_ACTION_ID}}"
SURF_LLM_WAKE_ACK_ACTION_LABEL="${SURF_LLM_WAKE_ACK_ACTION_LABEL:-${SURF_QWEN_WAKE_ACK_ACTION_LABEL:-面前挥手}}"
SURF_QWEN_WAKE_ACK_ACTION_LABEL="${SURF_QWEN_WAKE_ACK_ACTION_LABEL:-${SURF_LLM_WAKE_ACK_ACTION_LABEL}}"
SURF_LLM_THINKING_ACK_ENABLE="${SURF_LLM_THINKING_ACK_ENABLE:-${SURF_QWEN_THINKING_ACK_ENABLE:-1}}"
SURF_QWEN_THINKING_ACK_ENABLE="${SURF_QWEN_THINKING_ACK_ENABLE:-${SURF_LLM_THINKING_ACK_ENABLE}}"
SURF_LLM_THINKING_ACK_TEXT="${SURF_LLM_THINKING_ACK_TEXT:-${SURF_QWEN_THINKING_ACK_TEXT:-收到，我在思考}}"
SURF_QWEN_THINKING_ACK_TEXT="${SURF_QWEN_THINKING_ACK_TEXT:-${SURF_LLM_THINKING_ACK_TEXT}}"
SURF_LLM_THINKING_ACTION_ENABLE="${SURF_LLM_THINKING_ACTION_ENABLE:-${SURF_QWEN_THINKING_ACTION_ENABLE:-0}}"
SURF_QWEN_THINKING_ACTION_ENABLE="${SURF_QWEN_THINKING_ACTION_ENABLE:-${SURF_LLM_THINKING_ACTION_ENABLE}}"
SURF_LLM_WAKE_LISTEN_SEC="${SURF_LLM_WAKE_LISTEN_SEC:-${SURF_QWEN_WAKE_LISTEN_SEC:-8.0}}"
SURF_QWEN_WAKE_LISTEN_SEC="${SURF_QWEN_WAKE_LISTEN_SEC:-${SURF_LLM_WAKE_LISTEN_SEC}}"

# RAG backend configuration. Used when LLM_REPLY_BACKEND=rag.
RAG_SERVER_HOST="${RAG_SERVER_HOST:-127.0.0.1}"
RAG_SERVER_PORT="${RAG_SERVER_PORT:-8010}"
SOURCE_DB="${SOURCE_DB:-${WORKSPACE_ROOT}/xjtlu-rag-system/xjtlu_knowledge.db}"
RAG_DB="${RAG_DB:-${WORKSPACE_ROOT}/xjtlu-rag-system/rag_index.db}"
MEMORY_DB="${MEMORY_DB:-${WORKSPACE_ROOT}/runtime/xjtlu_chat_memory.db}"
CHAT_PROVIDER="${CHAT_PROVIDER:-openai}"
EMBED_PROVIDER="${EMBED_PROVIDER:-ollama}"
OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
OLLAMA_HOME="${OLLAMA_HOME:-${DEPS_ROOT}/ollama-home}"
OLLAMA_BIN="${OLLAMA_BIN:-${DEPS_ROOT}/ollama/bin/ollama}"
OLLAMA_MODELS="${OLLAMA_MODELS:-${OLLAMA_HOME}/models}"
EMBED_MODEL="${EMBED_MODEL:-nomic-embed-text}"
CHAT_MODEL="${CHAT_MODEL:-deepseek-v4-pro}"
OPENAI_BASE_URL="${OPENAI_BASE_URL:-https://api.deepseek.com}"
OPENAI_API_KEY="${OPENAI_API_KEY:-}"
TOP_K="${TOP_K:-6}"
SIMILARITY_THRESHOLD="${SIMILARITY_THRESHOLD:-0.35}"
ANSWER_MAX_CHARS="${ANSWER_MAX_CHARS:-100}"

DASHSCOPE_API_KEY="${DASHSCOPE_API_KEY:-}"
