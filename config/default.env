# Default runtime configuration. Put machine-specific overrides and API keys in
# config/local.env; it is sourced at the end of this file and is git-ignored.
#
# Paths to bundled dependencies. These values are overrideable so the workspace
# can still use external installs when needed.
WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPS_ROOT="${DEPS_ROOT:-${WORKSPACE_ROOT}/deps}"
SURF_ROOT="${SURF_ROOT:-${DEPS_ROOT}/SURF2026_VoiceModule-main}"
QWEN_ROOT="${QWEN_ROOT:-${DEPS_ROOT}/qwen_ros_node_edg_tts}"

# qwen mode: listen means every /audio_msg is handled. wake means qwen also
# applies its own wake-word filter after SURF ASR.
SURF_QWEN_MODE="wake"
SURF_QWEN_WAKE_WORDS=

# Voice input source for integrated pipeline.
VOICE_AUDIO_SOURCE="${VOICE_AUDIO_SOURCE:-robot}"

# Low-latency SURF overrides. These are sourced before SURF's original
# default.env, so run_surf_voice_runtime.sh reapplies them after sourcing SURF.
SURF_QWEN_ASR_WINDOW_SEC="${SURF_QWEN_ASR_WINDOW_SEC:-8.0}"
SURF_QWEN_VAD_HOLDOFF_SEC="${SURF_QWEN_VAD_HOLDOFF_SEC:-4.0}"

# Wake word mode for SURF voice runtime.
VOICE_WAKE_WORD_LANG="${VOICE_WAKE_WORD_LANG:-zh}"

# Must stay 0 in this integrated setup, because SURF is the ASR publisher.
QWEN_AUTOSTART_ASR_BRIDGE="${QWEN_AUTOSTART_ASR_BRIDGE:-0}"

# Copied qwen runtime configuration.
QWEN_AUDIO_TOPIC="${QWEN_AUDIO_TOPIC:-/audio_msg}"
QWEN_PYTHON="${QWEN_PYTHON:-${HOME}/miniconda3/envs/qwen/bin/python}"
QWEN_SERVER_URL="${QWEN_SERVER_URL:-http://127.0.0.1:8000/infer}"
QWEN_REQUEST_TIMEOUT_SEC="${QWEN_REQUEST_TIMEOUT_SEC:-60}"
QWEN_WAKE_WORDS="${QWEN_WAKE_WORDS:-你好小浦,小浦}"
QWEN_MODEL_PATH="${QWEN_MODEL_PATH:-${DEPS_ROOT}/Qwen3.5-0.8B/model}"
QWEN_REPLY_BACKEND="rag"
QWEN_DASHSCOPE_MODEL="${QWEN_DASHSCOPE_MODEL:-qwen-plus}"
QWEN_DASHSCOPE_BASE_URL="${QWEN_DASHSCOPE_BASE_URL:-https://dashscope.aliyuncs.com/compatible-mode/v1}"
QWEN_RAG_SERVER_URL="${QWEN_RAG_SERVER_URL:-http://127.0.0.1:8010/chat}"
QWEN_SERVER_HOST="${QWEN_SERVER_HOST:-0.0.0.0}"
QWEN_SERVER_PORT="${QWEN_SERVER_PORT:-8000}"
QWEN_MAX_NEW_TOKENS="${QWEN_MAX_NEW_TOKENS:-50}"
QWEN_TEMPERATURE="${QWEN_TEMPERATURE:-0.3}"
QWEN_RUNTIME_DIR="${QWEN_RUNTIME_DIR:-${WORKSPACE_ROOT}/runtime}"

UNITREE_DOMAIN_ID="${UNITREE_DOMAIN_ID:-0}"
UNITREE_ENABLE="${UNITREE_ENABLE:-1}"
UNITREE_NETWORK_INTERFACE="${UNITREE_NETWORK_INTERFACE:-enp8s0}"
UNITREE_AUDIO_VOLUME="${UNITREE_AUDIO_VOLUME:-85}"

QWEN_ACTION_ENABLE="${QWEN_ACTION_ENABLE:-1}"
QWEN_ACTION_EXECUTE="${QWEN_ACTION_EXECUTE:-1}"
QWEN_ACTION_BACKEND="${QWEN_ACTION_BACKEND:-deepseek}"
QWEN_ACTION_THRESHOLD="${QWEN_ACTION_THRESHOLD:-0.8}"
QWEN_ACTION_AUTO_RELEASE="${QWEN_ACTION_AUTO_RELEASE:-0}"
QWEN_ACTION_RELEASE_AFTER_SEC="${QWEN_ACTION_RELEASE_AFTER_SEC:-5}"
QWEN_ACTION_ROOT="${QWEN_ACTION_ROOT:-${DEPS_ROOT}/unitree_g1_action_classifier_package}"
QWEN_ACTION_PYTHON="${QWEN_ACTION_PYTHON:-${QWEN_ACTION_ROOT}/.venv/bin/python}"
QWEN_ACTION_SCRIPT="${QWEN_ACTION_SCRIPT:-${QWEN_ACTION_ROOT}/arm_action_classifier/arm_action_classifier.py}"
QWEN_ACTION_RUNNER="${QWEN_ACTION_RUNNER:-${QWEN_ACTION_ROOT}/unitree_sdk2/build/bin/g1_arm_action_example}"

# SURF context topics consumed by the integrated qwen node.
SURF_WAKE_TOPIC="${SURF_WAKE_TOPIC:-/wake_word_event}"
SURF_VAD_TOPIC="${SURF_VAD_TOPIC:-/vad_state}"
SURF_SPEAKER_TOPIC="${SURF_SPEAKER_TOPIC:-/speaker_id}"
SURF_QWEN_INCLUDE_SPEAKER_CONTEXT="${SURF_QWEN_INCLUDE_SPEAKER_CONTEXT:-1}"
SURF_QWEN_WRITE_CONTEXT_STATUS="${SURF_QWEN_WRITE_CONTEXT_STATUS:-1}"
SURF_QWEN_FILTER_BAD_ASR="${SURF_QWEN_FILTER_BAD_ASR:-1}"
SURF_QWEN_MIN_ASR_CHARS="${SURF_QWEN_MIN_ASR_CHARS:-2}"
SURF_QWEN_MIN_AUDIO_CONFIDENCE="${SURF_QWEN_MIN_AUDIO_CONFIDENCE:-0.55}"
SURF_QWEN_WAKE_ACK_ENABLE="${SURF_QWEN_WAKE_ACK_ENABLE:-1}"
SURF_QWEN_WAKE_ACK_TEXT="${SURF_QWEN_WAKE_ACK_TEXT:-我在}"
SURF_QWEN_WAKE_ACK_TEXT_ZH="${SURF_QWEN_WAKE_ACK_TEXT_ZH:-我在}"
SURF_QWEN_WAKE_ACK_TEXT_EN="${SURF_QWEN_WAKE_ACK_TEXT_EN:-here i am}"
SURF_QWEN_WAKE_ACK_COOLDOWN_SEC="${SURF_QWEN_WAKE_ACK_COOLDOWN_SEC:-1.0}"
SURF_QWEN_WAKE_ACK_ACTION_ENABLE="${SURF_QWEN_WAKE_ACK_ACTION_ENABLE:-1}"
SURF_QWEN_WAKE_ACK_ACTION_ID="${SURF_QWEN_WAKE_ACK_ACTION_ID:-25}"
SURF_QWEN_WAKE_ACK_ACTION_LABEL="${SURF_QWEN_WAKE_ACK_ACTION_LABEL:-面前挥手}"
SURF_QWEN_THINKING_ACK_ENABLE="${SURF_QWEN_THINKING_ACK_ENABLE:-1}"
SURF_QWEN_THINKING_ACK_TEXT="${SURF_QWEN_THINKING_ACK_TEXT:-收到，我在思考}"
SURF_QWEN_THINKING_ACTION_ENABLE="${SURF_QWEN_THINKING_ACTION_ENABLE:-0}"
SURF_QWEN_WAKE_LISTEN_SEC="${SURF_QWEN_WAKE_LISTEN_SEC:-8.0}"
QWEN_ACTION_KEYWORD_FIRST="${QWEN_ACTION_KEYWORD_FIRST:-1}"

# RAG backend configuration. Used when QWEN_REPLY_BACKEND=rag.
RAG_SERVER_HOST="${RAG_SERVER_HOST:-127.0.0.1}"
RAG_SERVER_PORT="${RAG_SERVER_PORT:-8010}"
SOURCE_DB="${SOURCE_DB:-${WORKSPACE_ROOT}/xjtlu-rag-system/xjtlu_knowledge.db}"
RAG_DB="${RAG_DB:-${WORKSPACE_ROOT}/xjtlu-rag-system/rag_index.db}"
MEMORY_DB="${MEMORY_DB:-${WORKSPACE_ROOT}/runtime/xjtlu_chat_memory.db}"
CHAT_PROVIDER="openai"
EMBED_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_HOME="${OLLAMA_HOME:-${DEPS_ROOT}/ollama-home}"
OLLAMA_BIN="${OLLAMA_BIN:-${DEPS_ROOT}/ollama/bin/ollama}"
OLLAMA_MODELS="${OLLAMA_MODELS:-${OLLAMA_HOME}/models}"
EMBED_MODEL="nomic-embed-text"
CHAT_MODEL="deepseek-v4-pro"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY="${OPENAI_API_KEY:-}"
TOP_K="${TOP_K:-6}"
SIMILARITY_THRESHOLD="${SIMILARITY_THRESHOLD:-0.35}"
ANSWER_MAX_CHARS="${ANSWER_MAX_CHARS:-100}"

DASHSCOPE_API_KEY="${DASHSCOPE_API_KEY:-}"

LOCAL_ENV="${WORKSPACE_ROOT}/config/local.env"
if [[ -f "${LOCAL_ENV}" ]]; then
  source "${LOCAL_ENV}"
fi
