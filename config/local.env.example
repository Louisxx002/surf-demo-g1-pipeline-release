# Copy this file to config/local.env on each target machine and fill in the
# machine-specific values. Do not commit config/local.env.

# Python environments.
LLM_PYTHON="${HOME}/miniconda3/envs/llm/bin/python"
VOICE_PYTHON="${HOME}/miniconda3/envs/voice/bin/python"

# Robot and DDS network.
UNITREE_NETWORK_INTERFACE="enp8s0"
UNITREE_DOMAIN_ID="0"
VOICE_AUDIO_SOURCE="robot"
VOICE_ROBOT_MIC_IF="192.168.123.222"
VOICE_ROBOT_MIC_PORT="5555"

# Voice recording behavior.
SURF_LLM_ASR_WINDOW_SEC="8.0"
SURF_LLM_VAD_HOLDOFF_SEC="3.5"
VOICE_ASR_VAD_MODEL=""
VOICE_KEEP_ASR_DEADLINE="0"
VOICE_VAD_SILENCE_FRAMES="25"

# Reply backend.
LLM_REPLY_BACKEND="rag"
LLM_MAX_NEW_TOKENS="35"
LLM_TEMPERATURE="0.3"
ANSWER_MAX_CHARS="100"

# RAG and model providers.
CHAT_PROVIDER="openai"
CHAT_MODEL="deepseek-v4-pro"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY="sk-your-deepseek-api-key"
EMBED_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
EMBED_MODEL="nomic-embed-text"
TOP_K="6"
SIMILARITY_THRESHOLD="0.35"

# Optional DashScope usage for DashScope Qwen/action backends that need it.
DASHSCOPE_API_KEY=""

# UX toggles.
SURF_LLM_THINKING_ACK_ENABLE="0"
SURF_LLM_WAKE_ACK_ENABLE="1"
SURF_LLM_WAKE_ACK_TEXT_ZH="我在"
