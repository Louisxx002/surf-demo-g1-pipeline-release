# SURF2026 VoiceModule default configuration.
# Source this file before running scripts, or override with environment variables.

# ── Audio pipeline ────────────────────────────────────────────────────────────
CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${CONFIG_DIR}/.." && pwd)"

VOICE_SAMPLE_RATE="${VOICE_SAMPLE_RATE:-16000}"
VOICE_CHANNELS="${VOICE_CHANNELS:-1}"
VOICE_FRAME_MS="${VOICE_FRAME_MS:-20}"
VOICE_BUS_BUFFER_SEC="${VOICE_BUS_BUFFER_SEC:-1.0}"

# local = PC mic (sounddevice), robot = UDP multicast from G1
VOICE_AUDIO_SOURCE="${VOICE_AUDIO_SOURCE:-robot}"

# ── Robot mic UDP multicast ───────────────────────────────────────────────────
VOICE_ROBOT_MIC_GROUP="${VOICE_ROBOT_MIC_GROUP:-239.168.123.161}"
VOICE_ROBOT_MIC_PORT="${VOICE_ROBOT_MIC_PORT:-5555}"
# PC/WSL interface on the Unitree robot subnet. USB mic UDP forwarding also
# targets this address by default from tools/stream_usb_mic.py.
VOICE_ROBOT_MIC_IF="${VOICE_ROBOT_MIC_IF:-192.168.123.222}"

# ── Wake word ─────────────────────────────────────────────────────────────────
# Wake word mode: zh, en, or both.
VOICE_WAKE_WORD_LANG="${VOICE_WAKE_WORD_LANG:-zh}"
VOICE_KWS_MODEL_DIR="${VOICE_KWS_MODEL_DIR:-${PROJECT_ROOT}/models/kws}"
VOICE_WAKEUP_DEDUP_SEC="${VOICE_WAKEUP_DEDUP_SEC:-0.5}"
VOICE_WAKE_THRESHOLD="${VOICE_WAKE_THRESHOLD:-0.5}"

# ── VAD ───────────────────────────────────────────────────────────────────────
VOICE_VAD_SILENCE_FRAMES="${VOICE_VAD_SILENCE_FRAMES:-75}"
VOICE_VAD_HOLDOFF_SEC="${VOICE_VAD_HOLDOFF_SEC:-4.0}"

# ── ASR ───────────────────────────────────────────────────────────────────────
VOICE_ASR_MODEL="${VOICE_ASR_MODEL:-${HOME}/.cache/modelscope/hub/models/iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch}"
VOICE_ASR_VAD_MODEL="${VOICE_ASR_VAD_MODEL-}"
VOICE_ASR_VAD_MAX_SINGLE_SEGMENT_TIME="${VOICE_ASR_VAD_MAX_SINGLE_SEGMENT_TIME:-30000}"
VOICE_ASR_WINDOW_SEC="${VOICE_ASR_WINDOW_SEC:-8.0}"
# ── Voiceprint ────────────────────────────────────────────────────────────────
VOICE_VOICEPRINT_MODEL="${VOICE_VOICEPRINT_MODEL:-pyannote/wespeaker-voxceleb-resnet34-LM}"
VOICE_VOICEPRINT_SEC="${VOICE_VOICEPRINT_SEC:-3.5}"
VOICE_SPEAKER_SIM_THRESHOLD="${VOICE_SPEAKER_SIM_THRESHOLD:-0.50}"
VOICE_SPEAKER_MAX_HISTORY="${VOICE_SPEAKER_MAX_HISTORY:-20}"

# ── ROS2 topics ───────────────────────────────────────────────────────────────
VOICE_ROS_AUDIO_TOPIC=/audio_msg
VOICE_ROS_DIRECTION_TOPIC=/voice_direction
VOICE_ROS_WAKE_TOPIC=/wake_word_event
VOICE_ROS_VAD_TOPIC=/vad_state
VOICE_ROS_SPEAKER_TOPIC=/speaker_id

# ── Unitree / ROS2 network (shared with qwen_ros_node_edg_tts) ───────────────
UNITREE_DOMAIN_ID="${UNITREE_DOMAIN_ID:-0}"
UNITREE_NETWORK_INTERFACE="${UNITREE_NETWORK_INTERFACE:-enp8s0}"

# ── Python interpreter ────────────────────────────────────────────────────────
VOICE_PYTHON="${VOICE_PYTHON:-${HOME}/miniconda3/envs/voice/bin/python}"
